# All optional. With none set, the app runs fully on sample data and the rules engine.

# Amazon Bedrock (enables model-assisted classification and summaries). Credentials come from the
# standard AWS chain (IAM role, SSO profile, env vars). Use a model/inference profile enabled in your account.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# Amazon S3 (enables /api/attachments/presign)
S3_BUCKET=
